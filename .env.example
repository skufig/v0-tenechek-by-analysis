# === VPS CONFIGURATION ===

# Домен сайта
NEXT_PUBLIC_DOMAIN=teneck.top

# Директория для данных (JSON файлы)
# По умолчанию: ./data
DATA_DIR=/var/www/teneck.top/data

# === АДМИН ПАНЕЛЬ ===

# Пароль для входа в админку (/admin)
ADMIN_PASSWORD=your_secure_password_here

# === TELEGRAM BOT ===
# Создать бота: @BotFather -> /newbot
# Получить chat_id: написать боту, затем открыть https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === AMOCRM ===
# Документация: https://www.amocrm.ru/developers/content/oauth/step-by-step

AMOCRM_SUBDOMAIN=
AMOCRM_ACCESS_TOKEN=
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=

# === ЗАПУСК НА VPS ===
# 
# 1. Клонировать репозиторий:
#    git clone <repo> /var/www/teneck.top
#
# 2. Установить зависимости:
#    cd /var/www/teneck.top && pnpm install
#
# 3. Создать .env файл:
#    cp .env.example .env
#    nano .env  # заполнить значения
#
# 4. Создать директорию для данных:
#    mkdir -p /var/www/teneck.top/data
#    chown -R www-data:www-data /var/www/teneck.top/data
#
# 5. Собрать проект:
#    pnpm build
#
# 6. Запустить через PM2:
#    pm2 start pnpm --name "teneck" -- start
#    pm2 save
#
# 7. Настроить Nginx (proxy_pass http://localhost:3000)

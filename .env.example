# Админ панель
ADMIN_PASSWORD=your_secure_password_here

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# AmoCRM 
AMOCRM_SUBDOMAIN=your_subdomain
AMOCRM_ACCESS_TOKEN=your_access_token
AMOCRM_PIPELINE_ID=your_pipeline_id
AMOCRM_STATUS_ID=your_status_id

# База данных (опционально, по умолчанию ./data/leads.db)
DATABASE_PATH=/var/www/teneck.top/data/leads.db
